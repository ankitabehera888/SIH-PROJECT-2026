{
  "title": "Healthcare Platform - Production Operations & Data Quality",
  "timezone": "Asia/Kolkata",
  "panels": [
    {
      "title": "Platform Data Quality Score",
      "type": "gauge",
      "targets": [{"expr": "healthcare_quality_score"}],
      "min": 0,
      "max": 100,
      "thresholds": {"mode": "absolute", "steps": [{"value": 0, "color": "red"}, {"value": 90, "color": "yellow"}, {"value": 98, "color": "green"}]}
    },
    {
      "title": "Daily Pipeline Execution Duration (seconds)",
      "type": "graph",
      "targets": [{"expr": "healthcare_pipeline_duration_seconds"}]
    },
    {
      "title": "FastAPI Request Rate (req/sec)",
      "type": "graph",
      "targets": [{"expr": "rate(http_requests_total[5m])"}]
    },
    {
      "title": "PostgreSQL Active Connections",
      "type": "stat",
      "targets": [{"expr": "pg_stat_activity_count"}]
    },
    {
      "title": "Active Quality Incidents / Alerts",
      "type": "stat",
      "targets": [{"expr": "healthcare_active_alerts_count"}]
    }
  ]
}
