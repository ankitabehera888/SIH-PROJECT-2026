# Production Healthcare Data Platform Environment Template
# NEVER commit production credentials or actual .env files into Git

ENVIRONMENT=production
LOG_LEVEL=INFO

# Database Configuration (Use least-privilege users in production)
DATABASE_URL=postgresql://etl_user:CHANGE_ME_IN_PRODUCTION@healthcare_postgres:5432/healthcare_prod
ANALYTICS_DATABASE_URL=postgresql://analytics_user:CHANGE_ME_IN_PRODUCTION@healthcare_postgres:5432/healthcare_prod
AIRFLOW_DATABASE_URL=postgresql://airflow_user:CHANGE_ME_IN_PRODUCTION@healthcare_postgres:5432/airflow_db

# Redis Cache Broker
REDIS_URL=redis://healthcare_redis:6379/1

# Object Storage / Data Lake Backing
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_BUCKET=healthcare-data-lake-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Security & Secrets
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING
ENCRYPTION_KEY=CHANGE_THIS_TO_AES_256_BASE64_KEY

# Quality Gate Policies
STRICT_QUALITY_GATES=true
MAX_CRITICAL_FAILURES=0
RPO_TARGET_MINUTES=15
RTO_TARGET_MINUTES=60
