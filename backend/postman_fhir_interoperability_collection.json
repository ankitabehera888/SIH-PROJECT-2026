{
  "info": {
    "_postman_id": "fhir-abdm-interoperability-v1",
    "name": "Healthcare Platform - FHIR R4 & ABDM Interoperability (Phase 11)",
    "description": "Comprehensive Postman collection for testing HL7 FHIR R4 resources, longitudinal bundle export, ABHA identity linkage, and patient consent policies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api/v1", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "patientId", "value": "", "type": "string" },
    { "key": "encounterId", "value": "", "type": "string" },
    { "key": "observationId", "value": "", "type": "string" },
    { "key": "medicationRequestId", "value": "", "type": "string" },
    { "key": "serviceRequestId", "value": "", "type": "string" },
    { "key": "diagnosticOrderId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Verify ABHA Number (Gateway Simulation)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/interoperability/abdm/verify-abha/14-1234-5678-9012",
          "host": ["{{baseUrl}}"],
          "path": ["interoperability", "abdm", "verify-abha", "14-1234-5678-9012"]
        }
      }
    },
    {
      "name": "2. Link ABHA to Patient",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"system\": \"https://healthid.abdm.gov.in\",\n  \"value\": \"14-1234-5678-9012\",\n  \"identifier_type\": \"ABHA_NUMBER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/interoperability/patients/{{patientId}}/identifiers",
          "host": ["{{baseUrl}}"],
          "path": ["interoperability", "patients", "{{patientId}}", "identifiers"]
        }
      }
    },
    {
      "name": "3. List Patient Identifiers",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/interoperability/patients/{{patientId}}/identifiers",
          "host": ["{{baseUrl}}"],
          "path": ["interoperability", "patients", "{{patientId}}", "identifiers"]
        }
      }
    },
    {
      "name": "4. Register Consent Artefact",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patient_id\": \"{{patientId}}\",\n  \"purpose\": \"CARE_MANAGEMENT\",\n  \"scope\": \"ALL\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/interoperability/consents",
          "host": ["{{baseUrl}}"],
          "path": ["interoperability", "consents"]
        }
      }
    },
    {
      "name": "5. Get FHIR Patient",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/fhir/Patient/{{patientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["fhir", "Patient", "{{patientId}}"]
        }
      }
    },
    {
      "name": "6. Get FHIR Encounter",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/fhir/Encounter/{{encounterId}}",
          "host": ["{{baseUrl}}"],
          "path": ["fhir", "Encounter", "{{encounterId}}"]
        }
      }
    },
    {
      "name": "7. Get FHIR Observation",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/fhir/Observation/{{observationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["fhir", "Observation", "{{observationId}}"]
        }
      }
    },
    {
      "name": "8. Get FHIR MedicationRequest",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/fhir/MedicationRequest/{{medicationRequestId}}",
          "host": ["{{baseUrl}}"],
          "path": ["fhir", "MedicationRequest", "{{medicationRequestId}}"]
        }
      }
    },
    {
      "name": "9. Get FHIR ServiceRequest",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/fhir/ServiceRequest/{{serviceRequestId}}",
          "host": ["{{baseUrl}}"],
          "path": ["fhir", "ServiceRequest", "{{serviceRequestId}}"]
        }
      }
    },
    {
      "name": "10. Get FHIR DiagnosticReport",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/fhir/DiagnosticReport/{{diagnosticOrderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["fhir", "DiagnosticReport", "{{diagnosticOrderId}}"]
        }
      }
    },
    {
      "name": "11. Export Complete Longitudinal Patient Bundle",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/fhir/patient/{{patientId}}/bundle?bundle_type=collection",
          "host": ["{{baseUrl}}"],
          "path": ["fhir", "patient", "{{patientId}}", "bundle"],
          "query": [
            { "key": "bundle_type", "value": "collection" }
          ]
        }
      }
    },
    {
      "name": "12. Trigger Async Celery Bundle Export",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/fhir/patient/{{patientId}}/export-async",
          "host": ["{{baseUrl}}"],
          "path": ["fhir", "patient", "{{patientId}}", "export-async"]
        }
      }
    }
  ]
}
